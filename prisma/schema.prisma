generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  atracoes  Atracao[]
  createdAt DateTime  @default(now())
}

model Atracao {
  id                Int               @id @default(autoincrement())
  nome              String
  descricao         String
  cidade            String            @default("Balsas")
  estado            String            @default("MA")
  distanciaCentroKm Float?
  categoriaId       Int
  categoria         Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  tags              AtracaoTag[]
  avaliacoes        Avaliacao[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([categoriaId])
  @@index([nome])
}

model Tag {
  id       Int          @id @default(autoincrement())
  nome     String       @unique
  atracoes AtracaoTag[]
}

model AtracaoTag {
  atracaoId Int
  tagId     Int
  atracao   Atracao @relation(fields: [atracaoId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([atracaoId, tagId])
  @@index([tagId])
}

model Avaliacao {
  id        Int      @id @default(autoincrement())
  nota      Int
  comentario String?
  autor     String?
  atracaoId Int
  atracao   Atracao  @relation(fields: [atracaoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([atracaoId])
}
